# Copy this file to server/.env and fill in your own values.
#   Windows (PowerShell):  Copy-Item .env.example server\.env
#   macOS / Linux:         cp .env.example server/.env
# Never commit the real .env file.

# Express API
PORT=5000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=puppy_clone

# Address(es) of the React website, for CORS. Several can be separated with commas.
CLIENT_URL=http://localhost:5173
