# Copy this file to client/.env
# Leave VITE_API_URL empty while developing: Vite forwards /api to the backend on port 5000.
# For a separate deployment, put the full API address here, for example https://api.example.com/api
VITE_API_URL=

# Where the Vite dev server forwards /api (only used by `npm run dev`)
VITE_PROXY_TARGET=http://localhost:5000
